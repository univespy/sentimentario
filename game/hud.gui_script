local emotions = require("data.emotions")

local W    = 640
local H    = 1136
local CX   = W * 0.5
local IMG_Y  = 855
local DESC_Y = 645

local WHITE  = vmath.vector4(1,    1,    1,    1)
local GRAY   = vmath.vector4(0.55, 0.55, 0.55, 1)
local YELLOW = vmath.vector4(1,    0.85, 0.3,  1)
local GREEN  = vmath.vector4(0.2,  0.9,  0.3,  1)
local ORANGE = vmath.vector4(1,    0.7,  0.1,  1)
local DARK   = vmath.vector4(0.08, 0.08, 0.12, 1)

local BTN_W = 260
local BTN_H = 70

local BTN_POS = {
    joy       = vmath.vector3(160, 490, 0.2),
    sadness   = vmath.vector3(480, 490, 0.2),
    anger     = vmath.vector3(160, 390, 0.2),
    fear      = vmath.vector3(480, 390, 0.2),
    surprise  = vmath.vector3(160, 290, 0.2),
    affection = vmath.vector3(480, 290, 0.2),
}

local BOOK_CARD_W = 270
local BOOK_CARD_H = 130

local BOOK_POS = {
    joy       = vmath.vector3(160, 850, 0.2),
    sadness   = vmath.vector3(480, 850, 0.2),
    anger     = vmath.vector3(160, 690, 0.2),
    fear      = vmath.vector3(480, 690, 0.2),
    surprise  = vmath.vector3(160, 530, 0.2),
    affection = vmath.vector3(480, 530, 0.2),
}

-- ── node factories ────────────────────────────────────────────────────────────

local function make_box(pos, w, h, color)
    local n = gui.new_box_node(pos, vmath.vector3(w, h, 0))
    gui.set_color(n, color)
    gui.set_pivot(n, gui.PIVOT_CENTER)
    return n
end

local function make_text(pos, str, color, parent)
    local n = gui.new_text_node(pos, str)
    gui.set_color(n, color)
    gui.set_pivot(n, gui.PIVOT_CENTER)
    if parent then gui.set_parent(n, parent, false) end
    return n
end

-- ── animations ────────────────────────────────────────────────────────────────

local function anim_scene_enter(img, desc_lbl)
    gui.cancel_animation(img,      gui.PROP_POSITION)
    gui.cancel_animation(img,      gui.PROP_COLOR)
    gui.cancel_animation(desc_lbl, gui.PROP_COLOR)
    gui.cancel_animation(desc_lbl, gui.PROP_POSITION)

    local img_dest  = vmath.vector3(CX, IMG_Y,  0.1)
    local desc_dest = vmath.vector3(CX, DESC_Y, 0.2)
    gui.set_position(img,      vmath.vector3(CX, IMG_Y  - 30, 0.1))
    gui.set_position(desc_lbl, vmath.vector3(CX, DESC_Y - 30, 0.2))

    gui.set_color(img,      vmath.vector4(1, 1, 1, 0))
    gui.set_color(desc_lbl, vmath.vector4(1, 1, 1, 0))

    gui.animate(img,      gui.PROP_POSITION, img_dest,  gui.EASING_OUTQUAD, 0.35)
    gui.animate(img,      gui.PROP_COLOR,    WHITE,     gui.EASING_OUTQUAD, 0.35)
    gui.animate(desc_lbl, gui.PROP_POSITION, desc_dest, gui.EASING_OUTQUAD, 0.35)
    gui.animate(desc_lbl, gui.PROP_COLOR,    WHITE,     gui.EASING_OUTQUAD, 0.35, 0.1)
end

local function anim_scene_correct(img)
    gui.animate(img, gui.PROP_COLOR, GREEN, gui.EASING_OUTQUAD, 0.15, 0, function()
        gui.animate(img, gui.PROP_COLOR, WHITE, gui.EASING_OUTQUAD, 0.5)
    end)
end

local function anim_feedback_pop(lbl)
    gui.set_scale(lbl, vmath.vector3(1, 1, 1))
    gui.animate(lbl, gui.PROP_SCALE, vmath.vector3(1.35, 1.35, 1), gui.EASING_OUTQUAD, 0.12, 0, function()
        gui.animate(lbl, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTQUAD, 0.18)
    end)
end

local function anim_scene_shake(img)
    local base = gui.get_position(img)
    local offsets = { 12, -12, 10, -10, 7, -7, 0 }
    local function step(i)
        if i > #offsets then return end
        local p = vmath.vector3(base.x + offsets[i], base.y, base.z)
        gui.animate(img, gui.PROP_POSITION, p, gui.EASING_LINEAR, 0.06, 0, function()
            step(i + 1)
        end)
    end
    step(1)
end

local function anim_pulse(lbl)
    gui.cancel_animation(lbl, gui.PROP_COLOR)
    gui.animate(lbl, gui.PROP_COLOR, vmath.vector4(1, 1, 1, 0.35),
        gui.EASING_INOUTQUAD, 1.1, 0, function()
            gui.animate(lbl, gui.PROP_COLOR, WHITE,
                gui.EASING_INOUTQUAD, 1.1, 0, function()
                    anim_pulse(lbl)
                end)
        end)
end

local function anim_btn_press(btn)
    gui.cancel_animation(btn, gui.PROP_SCALE)
    gui.animate(btn, gui.PROP_SCALE, vmath.vector3(0.88, 0.88, 1), gui.EASING_OUTQUAD, 0.08, 0, function()
        gui.animate(btn, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTQUAD, 0.12)
    end)
end

local function anim_book_enter(book_cards)
    for i, e in ipairs(emotions.list) do
        local card     = book_cards[e.id]
        local base_pos = BOOK_POS[e.id]
        gui.cancel_animation(card, gui.PROP_POSITION)
        gui.set_position(card, vmath.vector3(base_pos.x, base_pos.y - 60, base_pos.z))
        gui.animate(card, gui.PROP_POSITION, base_pos, gui.EASING_OUTQUAD, 0.28, (i - 1) * 0.07)
    end
end

-- ── ui builder ────────────────────────────────────────────────────────────────

local function build(self)
    self.bg = make_box(vmath.vector3(CX, H * 0.5, 0), W, H, DARK)

    -- state debug label (top-left area)
    self.state_lbl = make_text(vmath.vector3(200, 1085, 0.1), "ACT_SELECT", GRAY)

    -- act · scene counter (shown during gameplay)
    self.act_lbl = make_text(vmath.vector3(CX, 1040, 0.1), "", WHITE)

    -- scene image
    self.scene_img = make_box(vmath.vector3(CX, IMG_Y, 0.1), 580, 300,
                              vmath.vector4(0.16, 0.16, 0.25, 1))
    gui.set_texture(self.scene_img, "scenes")

    -- scene description
    self.desc_lbl = make_text(vmath.vector3(CX, DESC_Y, 0.2), "", WHITE)
    gui.set_size(self.desc_lbl, vmath.vector3(560, 70, 0))
    gui.set_line_break(self.desc_lbl, true)

    -- hint (Ato 1 only)
    self.hint_lbl = make_text(vmath.vector3(CX, 597, 0.1), "", YELLOW)

    -- feedback line
    self.feedback_lbl = make_text(vmath.vector3(CX, 550, 0.1), "", WHITE)

    -- label above answer buttons
    self.choose_lbl = make_text(vmath.vector3(CX, 570, 0.1), "Qual e o sentimento?", GRAY)

    -- emotion answer buttons
    self.btns = {}
    for _, e in ipairs(emotions.list) do
        local c   = e.color
        local btn = make_box(BTN_POS[e.id], BTN_W, BTN_H, vmath.vector4(c.r, c.g, c.b, 1))
        make_text(vmath.vector3(0, 0, 0.1), e.label, vmath.vector4(0, 0, 0, 1), btn)
        self.btns[e.id] = btn
    end

    -- ── tela de seleção de ato ────────────────────────────────────────────────

    self.act_select_title = make_text(vmath.vector3(CX, 800, 0.1), "Escolha um Ato", WHITE)
    self.act_btns = {
        [1] = make_box(vmath.vector3(CX, 650, 0.2), 500, 80, vmath.vector4(0.25, 0.35, 0.55, 1)),
        [2] = make_box(vmath.vector3(CX, 540, 0.2), 500, 80, vmath.vector4(0.25, 0.35, 0.55, 1)),
        [3] = make_box(vmath.vector3(CX, 430, 0.2), 500, 80, vmath.vector4(0.25, 0.35, 0.55, 1)),
    }
    make_text(vmath.vector3(0, 0, 0.1), "Ato 1 — Aprender",   WHITE, self.act_btns[1])
    make_text(vmath.vector3(0, 0, 0.1), "Ato 2 — Reconhecer", WHITE, self.act_btns[2])
    make_text(vmath.vector3(0, 0, 0.1), "Ato 3 — Conectar",   WHITE, self.act_btns[3])

    -- ── botão persistente do Livro (canto superior direito) ───────────────────

    self.book_btn = make_box(vmath.vector3(570, 1085, 0.3), 110, 50,
                             vmath.vector4(0.28, 0.28, 0.40, 1))
    make_text(vmath.vector3(0, 0, 0.1), "Livro", WHITE, self.book_btn)

    -- ── Livro de Sentimentos ──────────────────────────────────────────────────

    self.book_title = make_text(vmath.vector3(CX, 1015, 0.1), "Livro de Sentimentos", WHITE)
    self.book_count = make_text(vmath.vector3(CX, 960,  0.1), "", GRAY)

    self.book_cards       = {}
    self.book_name_lbls   = {}
    self.book_status_lbls = {}

    for _, e in ipairs(emotions.list) do
        local c    = e.color
        local col  = vmath.vector4(c.r * 0.25, c.g * 0.25, c.b * 0.25, 1)
        local card = make_box(BOOK_POS[e.id], BOOK_CARD_W, BOOK_CARD_H, col)
        local name_lbl   = make_text(vmath.vector3(0,  18, 0.1), e.label,     GRAY, card)
        local status_lbl = make_text(vmath.vector3(0, -22, 0.1), "bloqueado", GRAY, card)
        self.book_cards[e.id]       = card
        self.book_name_lbls[e.id]   = name_lbl
        self.book_status_lbls[e.id] = status_lbl
    end

    self.back_btn = make_box(vmath.vector3(CX, 390, 0.2), 220, 60,
                             vmath.vector4(0.28, 0.28, 0.40, 1))
    make_text(vmath.vector3(0, 0, 0.1), "Voltar", WHITE, self.back_btn)

    -- ── modo cubo ─────────────────────────────────────────────────────────────

    self.mode_btn     = make_box(vmath.vector3(70, 1085, 0.3), 110, 50,
                                  vmath.vector4(0.28, 0.28, 0.40, 1))
    self.mode_btn_lbl = make_text(vmath.vector3(0, 0, 0.1), "Botoes", WHITE, self.mode_btn)

    self.confirm_btn = make_box(vmath.vector3(CX, 390, 0.2), 400, 80,
                                 vmath.vector4(0.25, 0.35, 0.55, 1))
    make_text(vmath.vector3(0, 0, 0.1), "Confirmar", WHITE, self.confirm_btn)
    gui.set_enabled(self.confirm_btn, false)

    self.cube_status_lbl = make_text(vmath.vector3(CX, 295, 0.1), "", GRAY)
    gui.set_enabled(self.cube_status_lbl, false)
end

-- ── visibility helpers ────────────────────────────────────────────────────────

local function show(node, on)
    gui.set_enabled(node, on)
end

local function show_buttons(self, on)
    show(self.choose_lbl, on)
    for _, e in ipairs(emotions.list) do
        show(self.btns[e.id], on)
    end
    self.btns_active = on
end

local function show_answer_ui(self, on)
    if self.cube_mode then
        show(self.confirm_btn,     on)
        show(self.cube_status_lbl, on)
        if on then
            gui.set_text(self.cube_status_lbl,
                self.cube_ready and "Cubo pronto — toque Confirmar" or "Aguardando conexao...")
            gui.set_color(self.cube_status_lbl, self.cube_ready and GREEN or GRAY)
        end
    else
        show_buttons(self, on)
    end
end

local function show_game_ui(self, on)
    show(self.act_lbl,   on)
    show(self.scene_img, on)
    show(self.desc_lbl,  on)
end

local function show_act_select_ui(self, on)
    show(self.act_select_title, on)
    show(self.act_btns[1],      on)
    show(self.act_btns[2],      on)
    show(self.act_btns[3],      on)
    self.act_select_active = on
end

local function show_book_ui(self, on)
    show(self.book_title, on)
    show(self.book_count, on)
    show(self.back_btn,   on)
    for _, e in ipairs(emotions.list) do
        show(self.book_cards[e.id], on)
    end
end

local function enter_act_select(self)
    gui.cancel_animation(self.act_select_title, gui.PROP_COLOR)
    show(self.hint_lbl,        false)
    show(self.feedback_lbl,    false)
    show_game_ui(self,          false)
    show_buttons(self,          false)
    show(self.confirm_btn,      false)
    show(self.cube_status_lbl,  false)
    show_book_ui(self,          false)
    show(self.book_btn,         true)
    show(self.mode_btn,         true)
    show_act_select_ui(self,    true)
    self.book_active = false
    anim_pulse(self.act_select_title)
end

local function enter_book(self)
    gui.cancel_animation(self.act_select_title, gui.PROP_COLOR)
    show(self.hint_lbl,      false)
    show(self.feedback_lbl,  false)
    show_game_ui(self,        false)
    show_buttons(self,        false)
    show_act_select_ui(self,   false)
    show(self.book_btn,        false)
    show(self.confirm_btn,     false)
    show(self.cube_status_lbl, false)

    local brightness    = { [0] = 0.25, [1] = 0.5, [2] = 0.75, [3] = 1.0 }
    local status_texts  = { [0] = "0 / 3", [1] = "1 / 3", [2] = "2 / 3", [3] = "descoberto!" }
    local discovered_n  = 0
    for _, e in ipairs(emotions.list) do
        local c   = e.color
        local cnt = self.progress[e.id] or 0
        local br  = brightness[cnt]
        if cnt >= 3 then discovered_n = discovered_n + 1 end
        gui.set_color(self.book_cards[e.id], vmath.vector4(c.r * br, c.g * br, c.b * br, 1))
        local lbl_col = cnt > 0 and WHITE or GRAY
        gui.set_color(self.book_name_lbls[e.id],   lbl_col)
        gui.set_color(self.book_status_lbls[e.id], lbl_col)
        gui.set_text(self.book_status_lbls[e.id],  status_texts[cnt])
    end

    gui.set_text(self.book_count, discovered_n .. " / 6 sentimentos descobertos")
    show_book_ui(self, true)
    anim_book_enter(self.book_cards)
    self.book_active = true
end

-- ── lifecycle ─────────────────────────────────────────────────────────────────

function init(self)
    msg.post(".", "acquire_input_focus")
    self.btns_active       = false
    self.book_active       = false
    self.act_select_active = false
    self.progress          = {}   -- emotion_id → count (0..3)
    self.cube_mode         = false
    self.cube_ready        = false
    build(self)
    enter_act_select(self)
end

-- ── message handler ───────────────────────────────────────────────────────────

function on_message(self, message_id, message, sender)

    if message_id == hash("state_changed") then
        gui.set_text(self.state_lbl, message.state)

        if message.state == "ACT_SELECT" then
            enter_act_select(self)

        elseif message.state == "PRESENTING" then
            self.book_active   = false
            self.cube_ready    = false
            gui.cancel_animation(self.act_select_title, gui.PROP_COLOR)
            show(self.hint_lbl,       false)
            show(self.feedback_lbl,   false)
            show_game_ui(self,         true)
            show_buttons(self,         false)
            show(self.confirm_btn,     false)
            show(self.cube_status_lbl, false)
            show_book_ui(self,         false)
            show_act_select_ui(self,   false)
            show(self.book_btn,        false)
            show(self.mode_btn,        false)

        elseif message.state == "WAITING_FOR_ANSWER" then
            show_answer_ui(self, true)
            show(self.book_btn,  true)
            show(self.mode_btn,  true)

        elseif message.state == "CORRECT" then
            self.btns_active = false
            show(self.book_btn,        false)
            show(self.mode_btn,        false)
            show(self.confirm_btn,     false)
            show(self.cube_status_lbl, false)

        elseif message.state == "WRONG" then
            self.btns_active = true

        elseif message.state == "BOOK" then
            enter_book(self)
        end

    elseif message_id == hash("present_scene") then
        gui.set_text(self.act_lbl,
            "Ato " .. message.act .. "  -  Cena " .. message.scene_index)
        gui.set_text(self.desc_lbl, message.description)
        gui.play_flipbook(self.scene_img, hash(message.image))
        anim_scene_enter(self.scene_img, self.desc_lbl)

        if message.hint ~= "" then
            gui.set_text(self.hint_lbl, "Dica: " .. message.hint)
            show(self.hint_lbl, true)
        else
            show(self.hint_lbl, false)
        end

    elseif message_id == hash("answer_correct") then
        local e = emotions.by_id[message.emotion_id]
        if message.book_eligible then
            self.progress[message.emotion_id] = message.progress
            if message.progress >= 3 then
                gui.set_text(self.feedback_lbl, "Descoberto!  " .. e.label .. "!")
                gui.set_color(self.feedback_lbl, GREEN)
                anim_scene_correct(self.scene_img)
            else
                gui.set_text(self.feedback_lbl,
                    "Correto!  " .. e.label .. "!  (" .. message.progress .. " / 3)")
                gui.set_color(self.feedback_lbl, GREEN)
            end
        else
            gui.set_text(self.feedback_lbl, "Correto! Mas nao conta para o livro desta vez.")
            gui.set_color(self.feedback_lbl, YELLOW)
        end
        show(self.feedback_lbl, true)
        anim_feedback_pop(self.feedback_lbl)

    elseif message_id == hash("answer_wrong") then
        if message.book_eligible then
            gui.set_text(self.feedback_lbl, "Quase! Tente de novo!")
        else
            gui.set_text(self.feedback_lbl, "Quase! Tente de novo! (nao conta para o livro)")
        end
        gui.set_color(self.feedback_lbl, ORANGE)
        show(self.feedback_lbl, true)
        anim_scene_shake(self.scene_img)

    elseif message_id == hash("input_mode_changed") then
        self.cube_mode  = message.cube_mode
        self.cube_ready = false
        gui.set_text(self.mode_btn_lbl, self.cube_mode and "Cubo" or "Botoes")
        local in_answer = self.btns_active or gui.is_enabled(self.confirm_btn)
        if in_answer then
            show_buttons(self, not self.cube_mode)
            show(self.confirm_btn,     self.cube_mode)
            show(self.cube_status_lbl, self.cube_mode)
            if self.cube_mode then
                gui.set_text(self.cube_status_lbl, "Aguardando conexao...")
                gui.set_color(self.cube_status_lbl, GRAY)
            end
        end

    elseif message_id == hash("cube_emotion_received") then
        self.cube_ready = true
        if gui.is_enabled(self.cube_status_lbl) then
            gui.set_text(self.cube_status_lbl,  "Cubo pronto — toque Confirmar")
            gui.set_color(self.cube_status_lbl, GREEN)
        end

    elseif message_id == hash("ws_status") then
        self.cube_ready = false
        if gui.is_enabled(self.cube_status_lbl) then
            if message.connected then
                gui.set_text(self.cube_status_lbl,  "Conectado — posicione o cubo")
                gui.set_color(self.cube_status_lbl, YELLOW)
            else
                gui.set_text(self.cube_status_lbl,  "Sem conexao com o cubo")
                gui.set_color(self.cube_status_lbl, ORANGE)
            end
        end
    end
end

-- ── input handler ─────────────────────────────────────────────────────────────

function on_input(self, action_id, action)
    if not (action_id == hash("touch") and action.pressed) then return end

    -- book is open: only back button works
    if self.book_active then
        if gui.pick_node(self.back_btn, action.x, action.y) then
            anim_btn_press(self.back_btn)
            msg.post("game_manager#game_manager", "close_book")
        end
        return true
    end

    -- mode toggle button
    if gui.is_enabled(self.mode_btn) and gui.pick_node(self.mode_btn, action.x, action.y) then
        anim_btn_press(self.mode_btn)
        msg.post("game_manager#game_manager", "toggle_input_mode")
        return true
    end

    -- persistent book button (visible in act_select and waiting_for_answer)
    if gui.is_enabled(self.book_btn) and gui.pick_node(self.book_btn, action.x, action.y) then
        anim_btn_press(self.book_btn)
        msg.post("game_manager#game_manager", "open_book")
        return true
    end

    -- confirm button (cube mode only)
    if self.cube_mode and gui.is_enabled(self.confirm_btn)
            and gui.pick_node(self.confirm_btn, action.x, action.y) then
        if self.cube_ready then
            anim_btn_press(self.confirm_btn)
            self.cube_ready = false
            gui.set_text(self.cube_status_lbl, "Aguardando cubo...")
            gui.set_color(self.cube_status_lbl, GRAY)
            msg.post("game_manager#game_manager", "confirm_cube")
        end
        return true
    end

    -- act selection buttons
    if self.act_select_active then
        for i = 1, 3 do
            if gui.pick_node(self.act_btns[i], action.x, action.y) then
                anim_btn_press(self.act_btns[i])
                msg.post("game_manager#game_manager", "select_act", { act = i })
                return true
            end
        end
        return true
    end

    -- emotion answer buttons
    if self.btns_active then
        for _, e in ipairs(emotions.list) do
            if gui.pick_node(self.btns[e.id], action.x, action.y) then
                anim_btn_press(self.btns[e.id])
                msg.post("game_manager#game_manager", "answer", { emotion_id = e.id })
                return true
            end
        end
    end
end
